# Copy this file to .env and adjust values. NEVER commit the real .env.

# --- SQL Server container ---
MSSQL_SA_PASSWORD=Str0ng_Passw0rd!

# --- API (local dotnet run) ---
# Overrides the placeholder password in appsettings.json.
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=QuizApp;User Id=sa;Password=Str0ng_Passw0rd!;TrustServerCertificate=True

# --- API (inside docker compose; host is the mssql service name) ---
# Used by the api service in docker-compose.yml once added (Step 7):
# ConnectionStrings__Docker=Server=mssql;Database=QuizApp;User Id=sa;Password=Str0ng_Passw0rd!;TrustServerCertificate=True

# --- JWT (set real values in .env for local dev; compose provides its own) ---
Jwt__Key=change-me-to-a-long-random-secret-at-least-32-chars
Jwt__Issuer=QuizApp.Api
Jwt__Audience=QuizApp.Web
Jwt__ExpiresInMinutes=60

# --- CORS ---
Cors__AllowedOrigins__0=http://localhost:4200

# --- Seed admin (defaults shown; override as needed) ---
Seed__Admin__UserName=admin
Seed__Admin__Email=admin@quizapp.local
Seed__Admin__Password=Admin@12345
