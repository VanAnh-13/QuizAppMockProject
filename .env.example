# =============================================================================
# Quizapp — Environment Variables for Docker Compose
#
# Copy this file to .env and adjust values before running:
#   cp .env.example .env
#   docker compose up -d --build
# =============================================================================

# --- Database (SQL Server) ---------------------------------------------------
SA_PASSWORD=<your-sa-password>
DB_NAME=Quizapp
DB_PORT=1433

# --- Backend (ASP.NET Core API) ----------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5269

# JWT — generate a real signing key:
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_ISSUER=quizapp-api
JWT_AUDIENCE=quizapp-client
JWT_SIGNING_KEY=<your-jwt-signing-key-min-32-bytes>
JWT_LIFETIME_MINUTES=60

# Opt in to sample quizzes and demo accounts (Development only). Demo accounts have a public password; use only locally.
SAMPLE_DATA_ENABLED=false

# --- Frontend (Angular + nginx) ----------------------------------------------
WEB_PORT=4200
